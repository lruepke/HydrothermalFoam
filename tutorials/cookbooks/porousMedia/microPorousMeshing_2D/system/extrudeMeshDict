FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom patch;

sourceCase ".";
sourcePatches (front);
exposedPatchName back;

flipNormals false;

extrudeModel        linearNormal;
nLayers             1;
linearNormalCoeffs
{
    thickness       50E-6;
}

mergeFaces false;   //true;


FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Lz 100;
vertices    //vertices definition
(
    (-400      0   0)  //coordinate of vertex 0
    (400       0   0)  //coordinate of vertex 1
    (1000       1   0)  //coordinate of vertex 2
    (-1000      1   0)  //coordinate of vertex 3
    (-400      0   $Lz)  //coordinate of vertex 0
    (400       0   $Lz)  //coordinate of vertex 1
    (1000       1   $Lz)  //coordinate of vertex 2
    (-1000      1   $Lz)  //coordinate of vertex 3
);
edges
(
    arc 3 2 (0 1000 0)
    arc 7 6 (0 1000 $Lz)
    arc 0 1 (0 400 0)
    arc 4 5 (0 400 $Lz)
);
blocks
(
    hex (0 1 2 3 4 5 6 7) (100 50 1) simpleGrading (1 1 1)
);
boundary
(
    bottom
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
    seafloor
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }
    sidewalls    //patch name
    {
        type patch ;
        faces   //face list
        (
            (0 4 7 3)
            (2 6 5 1)
        );
    }
    frontAndBack    //patch name
    {
        type empty; 
        faces //face list
        (
            (0 3 2 1)   //back face
            (4 5 6 7)   //front face
        );
    }
);

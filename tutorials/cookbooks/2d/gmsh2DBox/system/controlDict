FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application HydrothermalSinglePhaseDarcyFoam;

startFrom latestTime;

startTime 0;

stopAt endTime;

endTime 86400000000;

deltaT 8640000;

writeControl runTime;

writeInterval 864000000;

purgeWrite 0;

writeFormat ascii;

writePrecision 6;

writeCompression off;

timeFormat general;

timePrecision 6;

runTimeModifiable true;

libs 
( 
//    "libfreesteam.so" 
    "libHydrothermalBoundaryConditions.so"
//    "libHydroThermoPhysicalModels.so"
);


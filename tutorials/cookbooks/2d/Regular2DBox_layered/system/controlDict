FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application HTFoam;
startFrom startTime;
startTime 0;
stopAt endTime;
endTime 31557600000;   // 1000 years
deltaT 43200000;  // 500 days initial time step
adjustTimeStep yes;
maxCo           0.5;
maxDeltaT       86400000; 
writeControl adjustableRunTime;
writeInterval 315576000; // 10 years
purgeWrite 0;
writeFormat ascii;
writePrecision 6;
writeCompression off;
timeFormat general;
timePrecision 14;
runTimeModifiable true;
libs 
( 
    "libHydrothermalBoundaryConditions.so"
);

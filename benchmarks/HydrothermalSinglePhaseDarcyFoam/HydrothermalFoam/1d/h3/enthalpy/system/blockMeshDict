FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;
Lx 2000;
ymin 0;
ymax 100;
Lz 1;
vertices
(
    (0      $ymin       0)
    ($Lx    $ymin       0)
    ($Lx    $ymax     0)
    (0      $ymax     0)
    (0      $ymin       $Lz)
    ($Lx    $ymin       $Lz)
    ($Lx    $ymax     $Lz)
    (0      $ymax     $Lz)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (200 1 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    left
    {
        type patch ;
        faces
        (
            (0 4 7 3)
        );
    }

    right
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }

    topAndBottom
    {
        type empty;
        faces
        (
            (3 7 6 2)
            (1 5 4 0)
        );
    }

    frontAndBack
    {
        type empty;
        faces 
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

{
    left
    {
        type            empty;
    }
    right
    {
        type            empty;
    }
    top
    {
        type            fixedValue;
        value           uniform 623.15;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 773.15;
    }
    frontAndBack
    {
        type            empty;
    }

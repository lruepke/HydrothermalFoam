FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application HydrothermalSinglePhaseDarcyFoam;

startFrom latestTime;

startTime 0;

stopAt endTime;

endTime 1576800000000;

deltaT 864000;

adjustTimeStep yes;
maxCo           1; 
maxDeltaT       157680000000; 

writeControl adjustableRunTime;

writeInterval 157680000000;

purgeWrite 0;

writeFormat ascii;

writePrecision 6;

writeCompression off;

timeFormat general;

timePrecision 14;

runTimeModifiable true;

libs 
( 
    "libfreesteam.so" 
    "libHydrothermalBoundaryConditions.so"
    "libHydroThermoPhysicalModels.so"
);

functions
{
    probes
    {
        type        probes;
        libs  ("libsampling.so");
        enabled         true;
        writeControl       timeStep;
        writeInterval      1;

        fields
        (
            T
        );

        probeLocations
        (
            (0 -2500 0)
            (0 -2000 0)
            (0 -500 0)
            (-500 -1500 0)
        );
    }

    cuttingPlane
    {
        type            surfaces;
        libs            ("libsampling.so");

        writeControl    writeTime;

        surfaceFormat   vtk;
        fields          ( p T );

        interpolationScheme cellPoint;

        surfaces
        (
            zNormal
            {
                type            cuttingPlane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 0 0);
                    normal  (0 0 1);
                }
                interpolate     true;
            }
        );
    }

}